package Login;
import java.util.regex.Matcher;
import java.util.regex.Pattern;

public class Login {
    // Instance variables to store the user's details after registration.
    private String registeredUsername;
    private String registeredPassword;
    private String registeredCellPhone;
    private String firstName;
    private String lastName;
      // Constructor to initialize the first and last name of the user.
    public Login(String firstName, String lastName) {
        this.firstName = firstName;
        this.lastName = lastName;
    }
    
  
   // Checks if the username contains an underscore and is no more than five characters long.
     
  //return true if username is correctly formatted, false otherwise.
     
  public boolean checkUserName(String username) {
        // Check if username contains underscore and its length is <= 5.
        if (username.contains("_") && username.length() <= 5) {
            return true;
        }
        return false;
    }
    
    /**     * Checks if the password meets the complexity requirements:
     * - At least eight characters long.
      Contains a capital letter.
      Contains a number.
      Contains a special character.
  ensure that  username meets the complexity criteria, false otherwise.
     */
    public boolean checkPasswordComplexity(String password) {
        // Use regular expressions to verify each rule.
        if (password.length() < 8) {
            return false;
        }
        
  // Regex patterns for the required rules.
        Pattern uppercasePattern = Pattern.compile("[A-Z]");
        Pattern digitPattern = Pattern.compile("[0-9]");
        Pattern specialCharPattern = Pattern.compile("[^a-zA-Z0-9]");
        
  Matcher hasUppercase = uppercasePattern.matcher(password);
        Matcher hasDigit = digitPattern.matcher(password);
        Matcher hasSpecial = specialCharPattern.matcher(password);
        
   return hasUppercase.find() && hasDigit.find() && hasSpecial.find();
    }
    
    /**
Checks if the cell phone number contains the international country code
      and that the number (excluding the '+' sign) is no more than ten characters long
      @param cellPhone The cell phone number to check
     @return true if the cell phone number is correctly formatted, false otherwise
     */
    public boolean checkCellPhoneNumber(String cellPhone) {
        // A regular expression that ensures the number starts with a '+' and then has 1 to 10 digits.
        String regex = "^\\+[0-9]{1,10}$";
        Pattern pattern = Pattern.compile(regex);
        Matcher matcher = pattern.matcher(cellPhone);
        
   return matcher.matches();
    }    
    /**
     * Registers a user with the given details.
     It first validates the username, password, and cell phone number
     * return A registration message indicating that phone number is correcly formatted,else phone number is not correctly formatted
     */
    public String registerUser(String username, String password, String cellPhone) {
        StringBuilder message = new StringBuilder();
            // Validate username
        if (checkUserName(username)) {
            message.append("Username successfully captured.\n");
            registeredUsername = username;
        } else {
            message.append("Username is not correctly formatted, please ensure that your username contains an underscore and is no more than five characters in length.\n");
        }
        
  // Validate password
        if (checkPasswordComplexity(password)) {
            message.append("Password successfully captured.\n");
            registeredPassword = password;
        } else {
            message.append("Password is not correctly formatted; please ensure that the password contains at least eight characters, a capital letter, a number, and a special character.\n");
        }
        
  // Validate cell phone number
        if (checkCellPhoneNumber(cellPhone)) {
            message.append("Cell phone number successfully added.\n");
            registeredCellPhone = cellPhone;
        } else {
            message.append("Cell phone number incorrectly formatted or does not contain international code.\n");
        }
        
   // If all conditions are met, indicate that registration was successful.
        if (checkUserName(username) && checkPasswordComplexity(password) && checkCellPhoneNumber(cellPhone)) {
            message.append("User registered successfully.");
        }    
        return message.toString();
    }
      /**
     * Verifies that the login details entered match the stored details.
     * @param username The username entered during login.
     * @param password The password entered during login.
     * @return true if login details match; false otherwise.
     */
    public boolean loginUser(String username, String password) {
        return username.equals(registeredUsername) && password.equals(registeredPassword);
    }
    
  /**
     * Returns the login status message after attempting to log in.
     * @param username The username entered during login.
     * @param password The password entered during login.
     * @return A welcome message if login is successful, otherwise an error message.
     */
    public String returnLoginStatus(String username, String password) {
        if (loginUser(username, password)) {
            return "Welcome " + firstName + ", " + lastName + " it is great to see you again.";
        } else {
            return "Username or password incorrect, please try again.";
        }
    }
    
   // A simple test in the main method to demonstrate the functionality.
    public static void main(String[] args) {
        // Create an instance of Login with a first and last name.
        Login user = new Login("John", "Doe");
        
   // Example registration input values.
        String username = "jd_1";  // Valid: contains underscore and 4 characters long.
        String password = "Secret@123"; // Valid: >=8 characters, contains a capital letter, digit and special character.
        String cellPhone = "+1234567890"; // Valid: starts with '+' and has 10 digits.
  System.out.println("Registration:");
        System.out.println(user.registerUser(username, password, cellPhone));
        
      
  System.out.println("\nLogin:");
        // Successful login
        System.out.println(user.returnLoginStatus("jd_1", "Secret@123"));
        // Failed login attempt
        System.out.println(user.returnLoginStatus("jd_1", "wrongPassword"));
    }
}
